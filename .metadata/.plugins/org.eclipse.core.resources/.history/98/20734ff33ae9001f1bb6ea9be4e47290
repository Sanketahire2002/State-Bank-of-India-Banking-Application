package com.sbi.database;

import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;
import org.mindrot.jbcrypt.BCrypt;

public class AdminRegistration {

    // Method to insert an ADMIN user with passport photo
    public static void registerAdmin(String username, String password, String fullName, 
                                     String email, String phone, String photoPath) {
        Connection conn = null;
        PreparedStatement stmt = null;
        FileInputStream photoInputStream = null;

        try {
            // Get database connection
            conn = DBConnection.getConnection();

            // Hash the password using BCrypt
            String hashedPassword = BCrypt.hashpw(password, BCrypt.gensalt());

            // SQL query to insert ADMIN
            String sql = "INSERT INTO users (username, password_hash, full_name, email, phone, role, status, passport_photo) " +
                         "VALUES (?, ?, ?, ?, ?, 'ADMIN', 'ACTIVE', ?)";

            stmt = conn.prepareStatement(sql);
            stmt.setString(1, username);
            stmt.setString(2, hashedPassword);
            stmt.setString(3, fullName);
            stmt.setString(4, email);
            stmt.setString(5, phone);

            // Read image file
            File photoFile = new File(photoPath);
            if (photoFile.exists()) {
                photoInputStream = new FileInputStream(photoFile);
                stmt.setBinaryStream(6, photoInputStream, (int) photoFile.length());
            } else {
                System.out.println("Photo file not found: " + photoPath);
                stmt.setNull(6, java.sql.Types.BLOB);
            }

            // Execute update
            int rowsInserted = stmt.executeUpdate();
            if (rowsInserted > 0) {
                System.out.println("Admin registered successfully with photo!");
            } else {
                System.out.println("Failed to register admin.");
            }

        } catch (SQLException | IOException e) {
            System.err.println("Error during admin registration!");
            e.printStackTrace();
        } finally {
            // Close resources
            try {
                if (photoInputStream != null) photoInputStream.close();
                if (stmt != null) stmt.close();
                if (conn != null) conn.close();
            } catch (SQLException | IOException e) {
                e.printStackTrace();
            }
        }
    }

    // Main method (For testing)
    public static void main(String[] args) {
        registerAdmin("admin", "Admin@123", "SBI Admin", "admin@sbi.com", "9876543210", "C:\\Users\\sanke\\Pictures\\New folder\\Screenshot (430).png");
    }
}
