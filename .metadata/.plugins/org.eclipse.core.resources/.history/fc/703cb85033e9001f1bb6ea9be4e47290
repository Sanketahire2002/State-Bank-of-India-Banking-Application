package com.sbi.view;

import javax.swing.*;
import java.awt.*;

public class WelcomePage extends JFrame {
    
    public WelcomePage() {
        // Set frame title
        setTitle("State Bank of India");

        // Set frame icon (SBI logo)
        ImageIcon logoIcon = new ImageIcon("src/resources/sbi-logo.png");
        setIconImage(logoIcon.getImage());

        // Load welcome image
        ImageIcon welcomeImage = new ImageIcon("src/resources/welcome.jpg");
        JLabel imageLabel = new JLabel(welcomeImage);
        
        // Add image to frame
        add(imageLabel);

        // Frame settings
        setSize(welcomeImage.getIconWidth(), welcomeImage.getIconHeight()); // Set size based on image
        setLocationRelativeTo(null); // Center the frame
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setVisible(true);
    }

    public static void main(String[] args) {
        new WelcomePage();
    }
}
