package com.sbi.database;

import com.sbi.model.User;

import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;
import java.sql.*;

import org.mindrot.jbcrypt.BCrypt;

public class UserDAO {

    // Method to get user details by username
    public static User getUserByUsername(String username) {
        Connection conn = null;
        PreparedStatement stmt = null;
        ResultSet rs = null;
        User user = null;

        try {
            // Get database connection
            conn = DBConnection.getConnection();

            // SQL query to fetch user by username
            String sql = "SELECT * FROM users WHERE username = ?";
            stmt = conn.prepareStatement(sql);
            stmt.setString(1, username);

            // Execute query
            rs = stmt.executeQuery();

            // If user found, create User object
            if (rs.next()) {
                user = new User(
                    rs.getInt("user_id"),
                    rs.getString("username"),
                    rs.getString("password_hash"),
                    rs.getString("full_name"),
                    rs.getString("email"),
                    rs.getString("phone"),
                    rs.getString("role"),
                    rs.getString("status"),
                    rs.getTimestamp("created_at"),
                    rs.getTimestamp("updated_at"),
                    rs.getBytes("passport_photo") // Handle image as byte array
                );
            }
        } catch (SQLException e) {
            System.err.println("Error fetching user from database!");
            e.printStackTrace();
        } finally {
            // Close resources
            try {
                if (rs != null) rs.close();
                if (stmt != null) stmt.close();
                if (conn != null) conn.close();
            } catch (SQLException e) {
                e.printStackTrace();
            }
        }

        return user;
    }
    
    // Method to check if a username already exists
    public static boolean isUsernameExists(String username) {
        Connection conn = null;
        PreparedStatement stmt = null;
        ResultSet rs = null;
        boolean exists = false;

        try {
            // Get database connection
            conn = DBConnection.getConnection();

            // SQL Query to check if username exists
            String sql = "SELECT COUNT(*) FROM users WHERE username = ?";
            stmt = conn.prepareStatement(sql);
            stmt.setString(1, username);

            // Execute Query
            rs = stmt.executeQuery();
            if (rs.next()) {
                exists = rs.getInt(1) > 0;
            }
        } catch (SQLException e) {
            System.err.println("Error checking username in database!");
            e.printStackTrace();
        } finally {
            // Close resources
            try {
                if (rs != null) rs.close();
                if (stmt != null) stmt.close();
                if (conn != null) conn.close();
            } catch (SQLException e) {
                e.printStackTrace();
            }
        }

        return exists;
    }

    
 // Method to insert an ADMIN user with passport photo
    public static void registerAdmin(String username, String password, String fullName, 
                                     String email, String phone, String photoPath) {
        Connection conn = null;
        PreparedStatement stmt = null;
        FileInputStream photoInputStream = null;

        try {
            // Get database connection
            conn = DBConnection.getConnection();

            // Hash the password using BCrypt
            String hashedPassword = BCrypt.hashpw(password, BCrypt.gensalt());

            // SQL query to insert ADMIN
            String sql = "INSERT INTO users (username, password_hash, full_name, email, phone, role, status, passport_photo) " +
                         "VALUES (?, ?, ?, ?, ?, 'STUDENT', 'ACTIVE', ?)";

            stmt = conn.prepareStatement(sql);
            stmt.setString(1, username);
            stmt.setString(2, hashedPassword);
            stmt.setString(3, fullName);
            stmt.setString(4, email);
            stmt.setString(5, phone);

            // Read image file
            File photoFile = new File(photoPath);
            if (photoFile.exists()) {
                photoInputStream = new FileInputStream(photoFile);
                stmt.setBinaryStream(6, photoInputStream, (int) photoFile.length());
            } else {
                System.out.println("Photo file not found: " + photoPath);
                stmt.setNull(6, java.sql.Types.BLOB);
            }

            // Execute update
            int rowsInserted = stmt.executeUpdate();
            if (rowsInserted > 0) {
                System.out.println("Admin registered successfully with photo!");
            } else {
                System.out.println("Failed to register admin.");
            }

        } catch (SQLException | IOException e) {
            System.err.println("Error during admin registration!");
            e.printStackTrace();
        } finally {
            // Close resources
            try {
                if (photoInputStream != null) photoInputStream.close();
                if (stmt != null) stmt.close();
                if (conn != null) conn.close();
            } catch (SQLException | IOException e) {
                e.printStackTrace();
            }
        }
    }
    
    // Main method (For Testing)
    public static void main(String[] args) {
        User user = getUserByUsername("admin");
        if (user != null) {
            System.out.println("User Found: " + user);
        } else {
            System.out.println("User not found!");
        }
    }
}
